# Demonstrates:
# - Looping over objects directly
# - Looping by index when needed
# - Copying a list before modifying it
# - Calling methods on class instances
 
def main():
    dragons = [
        Dragon("Green Dragon", 0, 0, 1),
        Dragon("Red Dragon", 2, 2, 2),
        Dragon("Blue Dragon", 4, 3, 3),
        Dragon("Black Dragon", 5, -1, 4),
    ]
 
    # don't touch above this line
 
    # Loop directly over objects
    for drago in dragons:
        describe(drago)
 
    # Loop by index when position matters
    for d in range(0, len(dragons)):
        dragon_list = dragons.copy()      # create safe copy
        del dragon_list[d]               # remove current dragon from copy
        dragons[d].breathe_fire(3, 3, dragon_list)
 
 
