import random


class DeckOfCards:

    # Class variables (shared by ALL instances)
    SUITS = ["Hearts", "Diamonds", "Clubs", "Spades"]
    RANKS = [
        "Ace", "2", "3", "4", "5", "6", "7",
        "8", "9", "10", "Jack", "Queen", "King"
    ]

    def __init__(self):
        self.__cards = []  # Private instance variable (name mangling)
        self.create_deck()

    def create_deck(self):
        # Builds a fresh deck for THIS specific object.
        for suit in self.SUITS:
            for rank in self.RANKS:
                dis_deck = (rank, suit)
                self.__cards.append(dis_deck)

    def shuffle_deck(self):
        # Modifies the instance variable list in place
        random.shuffle(self.__cards)

    def deal_card(self):
        # Removes and returns one card if possible
        if len(self.__cards) > 0:
            return self.__cards.pop()
        return None

    def __str__(self):
        # Special method called when printing the object
        return f"The deck has {len(self.__cards)} cards"


# --------------------------------------------------
# INHERITANCE
# --------------------------------------------------

class Human:
    def __init__(self, name):
        self.__name = name  # Private instance variable

    def get_name(self):
        return self.__name


class Archer(Human):
    def __init__(self, name, num_arrows):
        # Calls Human constructor to initialize the Human part
        super().__init__(name)
        self.__num_arrows = num_arrows  # Archer-specific private state

    def get_num_arrows(self):
        return self.__num_arrows

    def use_arrows(self, num):
        if self.__num_arrows < num:
            raise Exception("not enough arrows")
        self.__num_arrows -= num


class Crossbowman(Archer):
    def __init__(self, name, num_arrows):
        # Calls Archer constructor which also calls Human constructor
        super().__init__(name, num_arrows)

    def triple_shot(self, target):
        # Reuses Archer behavior
        self.use_arrows(3)

        # target is expected to behave like a Human (has get_name)
        target_name = target.get_name()
        return f"{target_name} was shot by 3 crossbow bolts"


# --------------------------------------------------
# INHERITANCE CONCEPT SUMMARY
# --------------------------------------------------

# Child classes inherit attributes and methods.
# They can extend or override behavior.
# super() allows access to parent implementations.
# Crossbowman -> Archer -> Human (multi-level inheritance)


# --------------------------------------------------
# CONSTRUCTOR CHAINING (Rectangle -> Square)
# --------------------------------------------------

class Rectangle:
    def __init__(self, length, width):
        self.length = length
        self.width = width

    def get_area(self):
        return self.length * self.width

    def get_perimeter(self):
        return 2 * (self.length + self.width)


class Square(Rectangle):
    def __init__(self, length):
        # Pass length twice so Rectangle can initialize BOTH attributes
        super().__init__(length, length)
        # Square still ends up with self.width because Rectangle created it.


# Constructor chaining:
# Square calls Rectangle's __init__.
# Rectangle initializes the shared attributes.
# Inherited methods work because required attributes exist.


# --------------------------------------------------
# METHOD OVERRIDING AND super() FOR METHODS
# --------------------------------------------------

class Siege:
    def __init__(self, max_speed, efficiency):
        self.max_speed = max_speed
        self.efficiency = efficiency

    def get_trip_cost(self, distance, food_price):
        # Base implementation shared by all siege machines
        return (distance / self.efficiency) * food_price

    def get_cargo_volume(self):
        # Placeholder method for subclasses to implement
        pass


class BatteringRam(Siege):
    def __init__(self, max_speed, efficiency, load_weight, bed_area):
        # Reuse parent initialization
        super().__init__(max_speed, efficiency)
        self.load_weight = load_weight
        self.bed_area = bed_area

    # OVERRIDING parent method
    def get_trip_cost(self, distance, food_price):
        # Call the parent version first
        base_cost = super().get_trip_cost(distance, food_price)

        # Extend behavior with extra cost
        return base_cost + (self.load_weight * 0.01)

    def get_cargo_volume(self):
        return self.bed_area * 2


class Catapult(Siege):
    def __init__(self, max_speed, efficiency, cargo_volume):
        super().__init__(max_speed, efficiency)
        self.cargo_volume = cargo_volume

    def get_cargo_volume(self):
        return self.cargo_volume


# --------------------------------------------------
# KEY CONCEPTS: METHOD OVERRIDING
# --------------------------------------------------

# If a child defines a method with the same name,
# it overrides the parent version.

# super().method_name() allows:
# - Reusing parent logic
# - Extending behavior
# - Avoiding duplicate code

# This enables POLYMORPHISM:
# Different subclasses respond to the same method call differently.


# --------------------------------------------------
# ADVANCED COMPOSITION + METHOD OVERRIDING
# (Unit -> Dragon with Hitbox Rectangle)
# --------------------------------------------------

class Unit:
    def __init__(self, name, pos_x, pos_y):
        self.name = name          # Public instance variable
        self.pos_x = pos_x        # X coordinate of unit center
        self.pos_y = pos_y        # Y coordinate of unit center

    def in_area(self, x1, y1, x2, y2):
        # Treats the unit as a single point and checks if it lies in the area
        return (
            self.pos_x >= x1
            and self.pos_x <= x2
            and self.pos_y >= y1
            and self.pos_y <= y2
        )


class Dragon(Unit):
    def __init__(self, name, pos_x, pos_y, height, width, fire_range):

        # Initialize inherited state from Unit
        super().__init__(name, pos_x, pos_y)

        # Dragon-specific state
        self.height = height
        self.width = width
        self.fire_range = fire_range

        # Compute hitbox boundaries from center position
        x1 = self.pos_x - (self.width / 2)
        y1 = self.pos_y - (self.height / 2)
        x2 = self.pos_x + (self.width / 2)
        y2 = self.pos_y + (self.height / 2)

        # COMPOSITION:
        # Dragon HAS-A Rectangle used as its hitbox
        self.__hitbox = Rectangle(x1, y1, x2, y2)
        # __hitbox is private so outside code cannot directly modify it

    # METHOD OVERRIDING:
    # Replaces Unit.in_area with rectangle overlap logic instead of point logic
    def in_area(self, x1, y1, x2, y2):

        # Build a Rectangle for the target area
        rect = Rectangle(x1, y1, x2, y2)

        # Delegate overlap detection to Rectangle class
        return self.__hitbox.overlaps(rect)


class Rectangle:
    def __init__(self, x1, y1, x2, y2):
        # Private coordinates
        # We do not assume x1 < x2 or y1 < y2
        self.__x1 = x1
        self.__y1 = y1
        self.__x2 = x2
        self.__y2 = y2

    def overlaps(self, rect):
        # Checks if two rectangles overlap
        # Uses normalized boundary helpers to be safe
        return (
            self.get_left_x() <= rect.get_right_x()
            and self.get_right_x() >= rect.get_left_x()
            and self.get_top_y() >= rect.get_bottom_y()
            and self.get_bottom_y() <= rect.get_top_y()
        )

    # Helper methods normalize coordinates
    # so rectangle math works even if inputs were reversed

    def get_left_x(self):
        if self.__x1 < self.__x2:
            return self.__x1
        return self.__x2

    def get_right_x(self):
        if self.__x1 > self.__x2:
            return self.__x1
        return self.__x2

    def get_top_y(self):
        if self.__y1 > self.__y2:
            return self.__y1
        return self.__y2

    def get_bottom_y(self):
        if self.__y1 < self.__y2:
            return self.__y1
        return self.__y2


# --------------------------------------------------
# KEY CONCEPTS REINFORCED
# --------------------------------------------------

# 1) Inheritance
# Dragon IS-A Unit.

# 2) Method Overriding
# Dragon overrides in_area().
# Same method name.
# Different behavior.

# 3) Composition
# Dragon HAS-A Rectangle (hitbox).
# Geometry logic lives in Rectangle.

# 4) Encapsulation
# Rectangle coordinates are private (__x1 etc).
# Hitbox is private (__hitbox).

# 5) Delegation
# Dragon delegates overlap logic to Rectangle.

# 6) Polymorphism
# Unit and Dragon both respond to in_area().
# But their behavior is different.


# --------------------------------------------------
# OPERATOR OVERLOADING + ABSTRACT INTERFACE PATTERN
# (Card Comparison and Polymorphic Rounds)
# --------------------------------------------------

SUITS = ["Clubs", "Diamonds", "Hearts", "Spades"]
RANKS = [
    "2", "3", "4", "5", "6", "7", "8",
    "9", "10", "Jack", "Queen", "King", "Ace"
]


class Card:
    def __init__(self, rank, suit):
        self.rank = rank
        self.suit = suit

        # Convert rank and suit into numeric positions.
        # This gives each card a consistent, sortable value.
        self.rank_index = RANKS.index(rank)
        self.suit_index = SUITS.index(suit)

    # Enables: card1 == card2
    def __eq__(self, other):
        return (
            self.rank_index == other.rank_index
            and self.suit_index == other.suit_index
        )

    # Enables: card1 < card2
    # Defines ordering rules
    def __lt__(self, other):
        # Compare rank first
        if self.rank_index == other.rank_index:
            # If ranks are equal compare suits
            return self.suit_index < other.suit_index
        return self.rank_index < other.rank_index

    # Enables: card1 > card2
    def __gt__(self, other):
        if self.rank_index == other.rank_index:
            return self.suit_index > other.suit_index
        return self.rank_index > other.rank_index

    def __str__(self):
        return f"{self.rank} of {self.suit}"


# --------------------------------------------------
# ABSTRACT BASE STYLE CLASS
# --------------------------------------------------

class Round:
    def resolve_round(self):
        # This method intentionally contains no logic.
        #
        # It exists to define a required interface.
        # Subclasses MUST override this method.
        #
        # If someone tries to use Round directly:
        # r = Round()
        # r.resolve_round()
        # It will raise an error.
        raise NotImplementedError(
            "Subclasses must implement resolve_round()"
        )


# --------------------------------------------------
# POLYMORPHIC IMPLEMENTATIONS
# --------------------------------------------------

class HighCardRound(Round):
    def __init__(self, card1, card2):
        self.card1 = card1
        self.card2 = card2

    def resolve_round(self):
        # This overrides the parent version.
        # Python will call THIS method at runtime.
        if self.card1 > self.card2:
            return 1
        if self.card2 > self.card1:
            return 2
        return 0


class LowCardRound(Round):
    def __init__(self, card1, card2):
        self.card1 = card1
        self.card2 = card2

    def resolve_round(self):
        # Same method name.
        # Different rule logic.
        if self.card1 < self.card2:
            return 1
        if self.card2 < self.card1:
            return 2
        return 0


# --------------------------------------------------
# WHY resolve_round() WORKS
# --------------------------------------------------

# Round defines a CONTRACT.
# It promises that all subclasses will implement resolve_round().

# Even though Round.resolve_round() has no real logic,
# Python does NOT call it if a subclass overrides it.

# Example:

# rounds = [
#     HighCardRound(card1, card2),
#     LowCardRound(card3, card4)
# ]

# for r in rounds:
#     print(r.resolve_round())

# Python looks at the ACTUAL OBJECT TYPE at runtime.

# If r is HighCardRound:
#     Python calls HighCardRound.resolve_round()

# If r is LowCardRound:
#     Python calls LowCardRound.resolve_round()

# This behavior is called DYNAMIC DISPATCH.

# This is true POLYMORPHISM:
# Same method name.
# Same interface.
# Different behavior depending on object type.
